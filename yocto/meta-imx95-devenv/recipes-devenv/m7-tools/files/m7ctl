#!/bin/sh
# m7ctl - load, start, stop and talk to the Cortex-M7 from Linux (remoteproc).
#
#   m7ctl status                 remoteproc state + firmware name
#   m7ctl load <file.elf>        copy ELF to /lib/firmware and select it
#   m7ctl start | stop | restart
#   m7ctl run <file.elf>         stop (if running), load, start
#   m7ctl state                  print just the remoteproc state (offline/running/...)
#   m7ctl console                M7 window of the imx95 tmux console (or raw RPMsg TTY)
#
# Zephyr images must be built for imx95_evk/mimx9596/m7/ddr (or m7 for TCM)
# with a resource table (CONFIG_OPENAMP_RSC_TABLE); see zephyr/ in the repo.
set -eu

find_rproc() {
	for r in /sys/class/remoteproc/remoteproc*; do
		[ -e "$r/name" ] || continue
		# i.MX95: name is "imx-rproc", the device node is "imx95-cm7"
		# (remoteproc0 is the Neutron NPU, "neutron-rproc").
		case "$(cat "$r/name") $(readlink -f "$r/device")" in
		*cm7*|*m7*|imx-rproc*) echo "$r"; return 0 ;;
		esac
	done
	echo "m7ctl: no Cortex-M7 remoteproc found (is imx_rproc loaded? right dtb?)" >&2
	exit 1
}

R=$(find_rproc)
state() { cat "$R/state"; }

do_stop() {
	if [ "$(state)" = running ] || [ "$(state)" = attached ]; then
		# The Wimmo virtual EHCI's registers vanish with the M7: release Linux's driver first
		if command -v m7-vehci >/dev/null; then m7-vehci unbind || true; fi
		echo stop > "$R/state"
	fi
}

vehci_bind() {
	if command -v m7-vehci >/dev/null && [ -e /sys/bus/platform/devices/20420000.usb ]; then
		m7-vehci bind || true
	fi
}

do_load() {
	f=$1
	[ -f "$f" ] || { echo "m7ctl: $f not found" >&2; exit 1; }
	name=$(basename "$f")
	if [ "$(readlink -f "$f")" != "$(readlink -f "/lib/firmware/$name" 2>/dev/null || true)" ]; then
		install -m 0644 "$f" "/lib/firmware/$name"
	fi
	echo "$name" > "$R/firmware"
}

case "${1:-status}" in
state)   state ;;
status)
	echo "remoteproc: $R ($(cat "$R/name"))"
	echo "state:      $(state)"
	echo "firmware:   $(cat "$R/firmware")"
	ls /dev/ttyRPMSG* 2>/dev/null | sed 's/^/rpmsg tty:  /' || true
	;;
load)    [ $# -eq 2 ] || { echo "usage: m7ctl load <file.elf>" >&2; exit 2; }; do_stop; do_load "$2" ;;
start)   echo start > "$R/state"; vehci_bind ;;
stop)    do_stop ;;
restart) do_stop; echo start > "$R/state"; vehci_bind ;;
run)     [ $# -eq 2 ] || { echo "usage: m7ctl run <file.elf>" >&2; exit 2; }; do_stop; do_load "$2"; echo start > "$R/state"; vehci_bind ;;
console)
	if command -v imx95-console >/dev/null && [ -z "${TMUX:-}" ]; then
		exec imx95-console attach M7
	fi
	tty=$(ls /dev/ttyRPMSG* 2>/dev/null | head -1)
	[ -n "$tty" ] || { echo "m7ctl: no /dev/ttyRPMSG* (M7 not running, or rpmsg_tty not loaded)" >&2; exit 1; }
	exec picocom -q "$tty"
	;;
*) sed -n '2,13p' "$0" | sed 's/^# \{0,1\}//'; exit 2 ;;
esac
