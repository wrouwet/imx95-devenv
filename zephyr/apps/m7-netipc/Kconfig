mainmenu "m7-netipc"

config APP_USB2_AUTOSTART
	bool "Start the USB2 host at boot"
	default y
	depends on USB_HOST_STACK
	help
	  Needs the M7 to own USB2 (SM config mx95devenv with USB2 in LM1);
	  otherwise the first register access is a bus fault. Without it,
	  start the host with the "usb2 start" shell command.

config APP_VEHCI
	bool "Wimmo virtual EHCI for Linux on the A55"
	default y
	select VEHCI
	help
	  Emulate an EHCI controller in the first 4 KiB of the m7shm window for
	  Linux's stock ehci-platform driver (see src/vehci_a55.c).

config APP_VEHCI_XLAT
	bool "Translate the Wimmo virtual EHCI to the physical USB2 controller"
	default y
	depends on APP_VEHCI && !USB_HOST_STACK
	select VEHCI_XLAT
	help
	  Linux's EHCI driver enumerates and drives the devices on the physical
	  USB2 port through the virtual EHCI; the M7 relays every stage.

config APP_VEHCI_TESTDEV
	bool "Attach the Wimmo test device at boot"
	default y
	depends on APP_VEHCI && !APP_VEHCI_XLAT

config APP_VXHCI
	bool "Wimmo virtual xHCI with a virtual USB 3.0 drive, for Linux on the A55"
	default y
	select VXHCI
	help
	  Emulate an xHCI controller in the second 4 KiB of the m7shm window
	  for Linux's stock xhci-plat driver, with a RAM-backed SuperSpeed
	  mass storage device on its USB 3 port (see src/vxhci_a55.c).

source "Kconfig.zephyr"
