/*
 * SPDX-License-Identifier: Apache-2.0
 *
 * m7-netipc on the i.MX95 EVK Cortex-M7, running from DDR (0x80000000, loaded
 * by Linux remoteproc into the m7-ddr reserved region).
 *
 * IPC: same layout as the Linux imx95-19x19-evk dts cm7 node - vrings and
 * vdev buffers at 0x88000000, resource table at 0x88220000, MU7 doorbells.
 *
 * Ethernet: Linux owns NETC (block control, PSI/PF, EMDIO, PHY, PTP). The M7
 * drives only ENETC0 VF1 (VSI) through the same RJ45 port; the System Manager
 * config mx95devenv grants NETC_VSI1/NETC_LDID3 to the M7, and Linux's
 * m7-vf-handoff.service enables and trusts the VF.
 */

#include <zephyr/dt-bindings/memory-attr/memory-attr-arm.h>

/ {
	chosen {
		zephyr,ipc_shm = &shmem;
		zephyr,ipc_rsc_table = &rsc_table;
		zephyr,ipc = &mailbox0;
	};

	shmem: memory@88000000 {
		compatible = "mmio-sram";
		reg = <0x88000000 0x500000>;
	};

	rsc_table: memory@88220000 {
		compatible = "mmio-sram";
		reg = <0x88220000 0x100>;
	};

	mailbox0: mailbox {
		compatible = "zephyr,mbox-ipm";
		mboxes = <&mu7 1>, <&mu7 1>;
		mbox-names = "tx", "rx";
		status = "okay";
	};

	/*
	 * Memory window shared with Linux: the upper 128 KiB of DTCM. The DDR
	 * board target puts nothing in DTCM (zephyr,sram = &ddr). Linux maps the
	 * same memory at 0x20420000 (devenv dts m7-shm node, m7shm.ko); keep
	 * both in sync.
	 */
	m7shm: m7shm@20020000 {
		compatible = "devenv,imx95-m7shm";
		reg = <0x20020000 DT_SIZE_K(128)>;
	};

	/*
	 * USB2: ChipIdea EHCI host on the EVK Type-A port, owned by the M7 (SM
	 * config mx95devenv: USB2 in LM1; Linux has no USB2 node). Driver:
	 * modules/devenv uhc_ci_ehci. EHCI structures go in the first 32 KiB of
	 * DTCM (never cached on the M7); the controller reaches DTCM at
	 * 0x20400000 on the system bus, untranslated by the SMMU (m7-dma-handoff).
	 */
	usb2: zephyr_uhc0: usb@4c200000 {
		compatible = "devenv,ci-ehci";
		reg = <0x4c200000 0x200>, <0x4c200200 0x200>;
		reg-names = "core", "usbnc";
		interrupt-parent = <&nvic>;
		interrupts = <176 0>;
		devenv,pool = <0x20000000 DT_SIZE_K(32)>;
		devenv,pool-bus-addr = <0x20400000>;
		disable-over-current;
		status = "okay";
	};

	/*
	 * Linux DDR that the virtual EHCI ("Wimmo", src/vehci_a55.c) reads and
	 * writes: Linux's queue heads, qTDs and buffers for 32-bit DMA. The SM
	 * config grants the M7 0x90000000-0xDFFFFFFF; Linux keeps the vEHCI's DMA
	 * there (dma-ranges). Not cached on the M7, so both sides see each other's
	 * writes (Linux maps its coherent DMA memory non-cacheable too).
	 * ARMv7-M MPU regions: power-of-two sizes, aligned.
	 */
	/*
	 * Backing store of the virtual USB 3 drive (src/vxhci_a55.c): M7 DDR
	 * above the image, inside Linux's m7 reservation window but outside
	 * Linux RAM (which starts at 0x90000000). Cached: only the M7 uses it.
	 */
	vxhci_drive: memory@83000000 {
		compatible = "zephyr,memory-region", "mmio-sram";
		reg = <0x83000000 DT_SIZE_M(64)>;
		zephyr,memory-region = "VXHCI_DRIVE";
		zephyr,memory-attr = <DT_MEM_ARM(ATTR_MPU_RAM)>;
	};

	linux_ddr0: memory@90000000 {
		compatible = "zephyr,memory-region", "mmio-sram";
		reg = <0x90000000 DT_SIZE_M(256)>;
		zephyr,memory-region = "LINUX_DDR0";
		zephyr,memory-attr = <DT_MEM_ARM(ATTR_MPU_RAM_NOCACHE)>;
	};

	linux_ddr1: memory@a0000000 {
		compatible = "zephyr,memory-region", "mmio-sram";
		reg = <0xa0000000 DT_SIZE_M(512)>;
		zephyr,memory-region = "LINUX_DDR1";
		zephyr,memory-attr = <DT_MEM_ARM(ATTR_MPU_RAM_NOCACHE)>;
	};

	linux_ddr2: memory@c0000000 {
		compatible = "zephyr,memory-region", "mmio-sram";
		reg = <0xc0000000 DT_SIZE_M(512)>;
		zephyr,memory-region = "LINUX_DDR2";
		zephyr,memory-attr = <DT_MEM_ARM(ATTR_MPU_RAM_NOCACHE)>;
	};
};

&mu7 {
	status = "okay";
};

/* Owned by Linux on the A55 */
&netc_blk_ctrl {
	status = "disabled";
};

&enetc_psi0 {
	status = "disabled";
};

&emdio {
	status = "disabled";
};

&phy0 {
	status = "disabled";
};

&enetc_ptp_clock {
	status = "disabled";
};

/* ENETC0 VF1: the M7's network interface on the shared RJ45 port. Fixed,
 * locally administered MAC; Linux's m7-vf-handoff assigns the same one (VF_MAC).
 */
&enetc0_vsi1 {
	local-mac-address = [02 04 9f 95 00 07];
	status = "okay";
};
