# Build host for the NXP i.MX BSP (Yocto 6.0 wrynose) and for Zephyr.
# The host (Ubuntu 26.04) is newer than Yocto supports, so builds run in here.
FROM docker.io/library/ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential chrpath cpio debianutils diffstat file gawk gcc git \
        iputils-ping libacl1 liblz4-tool locales python3 python3-git \
        python3-jinja2 python3-pexpect python3-pip python3-subunit socat \
        texinfo unzip wget xz-utils zstd lz4 bc rsync curl ca-certificates \
        vim-tiny less tmux sudo openssh-client python-is-python3 \
        python3-venv python3-dev cmake ninja-build device-tree-compiler gperf ccache \
        dfu-util libsdl2-dev libmagic1 \
    && rm -rf /var/lib/apt/lists/* \
    && locale-gen en_US.UTF-8

# Google's repo tool (NXP ships its BSP as a repo manifest)
RUN curl -fsSL https://storage.googleapis.com/git-repo-downloads/repo -o /usr/local/bin/repo \
    && chmod 755 /usr/local/bin/repo

ENV LANG=en_US.UTF-8 LC_ALL=en_US.UTF-8
# bitbake refuses to run as root; run-in-container.sh uses --userns=keep-id
# so the container user is the host user.
